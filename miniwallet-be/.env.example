APP_NAME="Mini Wallet API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Production database credentials.
DB_CONNECTION=mysql
DB_HOST=your-database-host
DB_PORT=3306
DB_DATABASE=miniwallet_production
DB_USERNAME=your-database-user
DB_PASSWORD=change-this-database-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.example.com

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Configure a real provider if the application sends email in production.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=your-smtp-host
MAIL_PORT=587
MAIL_USERNAME=your-smtp-user
MAIL_PASSWORD=change-this-smtp-password
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Production frontend SPA origin. Used for CORS and cookie handling.
FRONTEND_URL=https://app.example.com

# Sanctum: include the SPA host without the scheme or path.
SANCTUM_STATEFUL_DOMAINS=app.example.com

# Auth cookie (httpOnly) that carries the Sanctum token.
# Use SameSite=None when the SPA and API are on different sites.
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_LIFETIME=1440
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=none
AUTH_COOKIE_DOMAIN=.example.com

# Wallet business rules (in rupiah, integer only)
WALLET_MIN_TOPUP=1000
WALLET_MAX_TOPUP=10000000
WALLET_MIN_TRANSFER=1000
WALLET_MAX_TRANSFER=10000000

# Super administrator bootstrap, used by `php artisan db:seed --class=AdminSeeder`.
# Replace every value below before running the seeder in production.
ADMIN_NAME="Super Admin"
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PHONE=replace-with-admin-phone
ADMIN_PASSWORD=replace-with-a-long-random-password
