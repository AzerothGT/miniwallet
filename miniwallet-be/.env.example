APP_NAME="Mini Wallet API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=miniwallet
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend SPA origin. Used for CORS and cookie handling.
FRONTEND_URL=http://localhost:5173

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# Auth cookie (httpOnly) that carries the Sanctum token.
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_LIFETIME=1440
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# Wallet business rules (in rupiah, integer only)
WALLET_MIN_TOPUP=1000
WALLET_MAX_TOPUP=10000000
WALLET_MIN_TRANSFER=1000
WALLET_MAX_TRANSFER=10000000

# Super administrator bootstrap, used by `php artisan db:seed --class=AdminSeeder`.
# Ganti ADMIN_EMAIL dan ADMIN_PASSWORD sebelum dipakai di luar lingkungan lokal.
ADMIN_NAME="Super Admin"
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=081200000000
ADMIN_PASSWORD=password123
